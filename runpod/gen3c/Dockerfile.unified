# =============================================================================
# Unified 3D Generation Docker Image for RunPod
# Includes: GEN3C + Lyra + TRELLIS.2 + SHARP
# =============================================================================
# 
# This Dockerfile builds a multi-model inference environment for RunPod.
# All models share Python 3.10 + NumPy 1.26.4 + PyTorch 2.6.0 (NVIDIA stack)
#
# Included Models:
#   - GEN3C: Image to video generation (NVIDIA Cosmos)
#   - Lyra: Image/Video to 3D/4D Gaussian Splatting (NVIDIA, built on GEN3C)
#   - TRELLIS.2: Image to 3D with O-Voxel representation (Microsoft)
#   - SHARP: Image to 3D Gaussian Splatting (Apple)
#
# Build: docker build -f Dockerfile.unified -t 88dreams/gen3c-runpod:v48 .
# Push:  docker push 88dreams/gen3c-runpod:v48
#
# v23: Updated Lyra dependencies (gsplat commit failed to build)
# v24: Fixed Lyra validation, reverted gsplat to stable 1.4.0
# v32: Patch Lyra's gs_deferred.py to work with gsplat 1.4.0 (remove with_ut args)
# v33: Pre-compile gsplat CUDA extensions during build
# v34: Rebuild gsplat from source with TORCH_CUDA_ARCH_LIST for all GPU archs
# v35: Fix nvcc compiler-bindir conflict by setting CC/CXX/CUDAHOSTCXX to system gcc
# v36: Fix PLY output path detection - search Lyra's default output directories
# v39: Add SuGaR mesh extraction support (3DGS -> GLB/OBJ)
#
# =============================================================================

# Use NVIDIA PyTorch container as base (includes CUDA 12.4)
FROM nvcr.io/nvidia/pytorch:24.10-py3

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# =============================================================================
# System Dependencies
# =============================================================================
RUN apt-get update && apt-get install -y \
    git \
    tree \
    ffmpeg \
    wget \
    curl \
    libjpeg-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Fix shell and CUDA library links
RUN rm /bin/sh && ln -s /bin/bash /bin/sh && \
    ln -sf /lib64/libcuda.so.1 /lib64/libcuda.so

WORKDIR /workspace

# =============================================================================
# Clone Repositories
# =============================================================================
# GEN3C (base for Lyra as well)
RUN git clone https://github.com/nv-tlabs/GEN3C.git /workspace/GEN3C

# Lyra (3D/4D Gaussian Splatting, built on GEN3C)
RUN git clone https://github.com/nv-tlabs/lyra.git /workspace/lyra

# TRELLIS.2 (O-Voxel 3D generation) - needs --recursive for o-voxel/third_party/eigen submodule
RUN git clone --recursive https://github.com/microsoft/TRELLIS.2.git /workspace/TRELLIS2

# SHARP (Apple's monocular view synthesis)
RUN git clone https://github.com/apple/ml-sharp.git /workspace/ml-sharp

# SuGaR (Surface-Aligned Gaussian Splatting for Mesh Extraction)
RUN git clone --recursive https://github.com/Anttwo/SuGaR.git /workspace/SuGaR

# =============================================================================
# Install Base Environment (Miniforge + Python 3.10)
# =============================================================================
# GEN3C's cosmos-predict1.yaml defines the base: Python 3.10, CUDA 12.4
RUN echo "Installing Miniforge and base environment..." && \
    mkdir -p ~/miniforge3 && \
    wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O ~/miniforge3/miniforge.sh && \
    bash ~/miniforge3/miniforge.sh -b -u -p ~/miniforge3 && \
    rm ~/miniforge3/miniforge.sh && \
    source ~/miniforge3/bin/activate && \
    conda env create --file /workspace/GEN3C/cosmos-predict1.yaml && \
    echo "✓ Base conda environment created (Python 3.10, CUDA 12.4)"

# =============================================================================
# Install GEN3C Dependencies
# =============================================================================
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing GEN3C dependencies..." && \
    pip install --no-cache-dir -r /workspace/GEN3C/requirements.txt && \
    # Link NVIDIA includes for compilation
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/nvidia/*/include/* $CONDA_PREFIX/include/ 2>/dev/null || true && \
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/nvidia/*/include/* $CONDA_PREFIX/include/python3.10 2>/dev/null || true && \
    ln -sf $CONDA_PREFIX/lib/python3.10/site-packages/triton/backends/nvidia/include/* $CONDA_PREFIX/include/ 2>/dev/null || true && \
    # Install transformer-engine
    pip install --no-cache-dir transformer-engine[pytorch]==1.12.0 && \
    # Install Apex (CUDA extensions)
    git clone https://github.com/NVIDIA/apex /tmp/apex && \
    cd /tmp/apex && \
    CUDA_HOME=$CONDA_PREFIX pip install -v --disable-pip-version-check --no-cache-dir --no-build-isolation \
        --config-settings "--build-option=--cpp_ext" \
        --config-settings "--build-option=--cuda_ext" . && \
    cd /workspace && rm -rf /tmp/apex && \
    # Install MoGe (depth estimation for GEN3C)
    pip install --no-cache-dir git+https://github.com/microsoft/MoGe.git && \
    # CRITICAL: Pin huggingface-hub for transformers compatibility
    pip install --no-cache-dir "huggingface-hub>=0.26.0,<1.0" && \
    echo "✓ GEN3C dependencies installed"

# =============================================================================
# Install Lyra Dependencies (on top of GEN3C)
# =============================================================================
# Lyra uses GEN3C as base and adds 3DGS reconstruction capabilities
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing Lyra dependencies..." && \
    # Lyra's additional requirements
    pip install --no-cache-dir \
        flash-attn==2.7.3 \
        timm==1.0.19 \
        kiui==0.2.17 \
        lru-dict==1.3.0 \
        deepspeed==0.17.5 \
        accelerate==1.10.0 \
        plyfile==1.1.2 \
        openexr==3.2.3 \
        mpi4py==4.1.0 && \
    # Install causal-conv1d (for Mamba)
    pip install --no-cache-dir git+https://github.com/Dao-AILab/causal-conv1d@v1.4.0 && \
    # Install gsplat - use stable version (specific commit fails to build)
    # We'll patch Lyra's code to remove unsupported arguments
    pip install --no-cache-dir gsplat==1.4.0 && \
    # Install fused-ssim
    pip install --no-cache-dir git+https://github.com/rahul-goel/fused-ssim/@8bdb59feb7b9a41b1fab625907cb21f5417deaac && \
    # Install Mamba (state space model)
    pip install --no-cache-dir --no-build-isolation "git+https://github.com/state-spaces/mamba@v2.2.4" && \
    echo "✓ Lyra dependencies installed"

# =============================================================================
# Patch Lyra for gsplat 1.4.0 compatibility
# The stable gsplat doesn't support 'with_ut' and 'with_eval3d' arguments
# =============================================================================
RUN echo "Patching Lyra for gsplat 1.4.0 compatibility..." && \
    sed -i "s/self.raster_kwargs = {'with_ut': True, 'with_eval3d': True, 'packed': False}/self.raster_kwargs = {'packed': False}/" /workspace/lyra/src/rendering/gs_deferred.py && \
    sed -i "s/self.raster_kwargs = {'with_ut': False, 'with_eval3d': False, 'packed': False}/self.raster_kwargs = {'packed': False}/" /workspace/lyra/src/rendering/gs_deferred.py && \
    echo "✓ Lyra patched for gsplat compatibility"

# =============================================================================
# gsplat CUDA compilation workaround
# The conda environment has compiler conflicts with nvcc
# Fix by setting correct compiler paths and environment variables
# =============================================================================
ENV TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0"
ENV TORCH_EXTENSIONS_DIR=/workspace/.torch_extensions
ENV MAX_JOBS=4
# Use system compiler instead of conda compiler to avoid nvcc conflicts
ENV CC=/usr/bin/gcc
ENV CXX=/usr/bin/g++
ENV CUDAHOSTCXX=/usr/bin/g++

RUN mkdir -p /workspace/.torch_extensions && \
    chmod 777 /workspace/.torch_extensions

# =============================================================================
# Install TRELLIS.2 Dependencies
# =============================================================================
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing TRELLIS.2 dependencies..." && \
    # Basic dependencies (transformers needed for model loading, timm already from Lyra)
    pip install --no-cache-dir \
        imageio \
        imageio-ffmpeg \
        tqdm \
        easydict \
        opencv-python-headless \
        ninja \
        trimesh \
        transformers \
        gradio==6.0.1 \
        tensorboard \
        pandas \
        lpips \
        zstandard \
        kornia && \
    # utils3d
    pip install --no-cache-dir git+https://github.com/EasternJournalist/utils3d.git@9a4eb15e4021b67b12c460c7057d642626897ec8 && \
    # pillow-simd (faster Pillow)
    pip install --no-cache-dir pillow-simd || pip install --no-cache-dir pillow && \
    # nvdiffrast (NVIDIA differentiable rendering)
    mkdir -p /tmp/extensions && \
    git clone -b v0.4.0 https://github.com/NVlabs/nvdiffrast.git /tmp/extensions/nvdiffrast && \
    pip install --no-cache-dir /tmp/extensions/nvdiffrast --no-build-isolation && \
    rm -rf /tmp/extensions/nvdiffrast && \
    # nvdiffrec (renderutils branch)
    git clone -b renderutils https://github.com/JeffreyXiang/nvdiffrec.git /tmp/extensions/nvdiffrec && \
    pip install --no-cache-dir /tmp/extensions/nvdiffrec --no-build-isolation && \
    rm -rf /tmp/extensions/nvdiffrec && \
    # CuMesh
    git clone https://github.com/JeffreyXiang/CuMesh.git /tmp/extensions/CuMesh --recursive && \
    pip install --no-cache-dir /tmp/extensions/CuMesh --no-build-isolation && \
    rm -rf /tmp/extensions/CuMesh && \
    # FlexGEMM
    git clone https://github.com/JeffreyXiang/FlexGEMM.git /tmp/extensions/FlexGEMM --recursive && \
    pip install --no-cache-dir /tmp/extensions/FlexGEMM --no-build-isolation && \
    rm -rf /tmp/extensions/FlexGEMM && \
    # O-Voxel (from TRELLIS.2 repo)
    cp -r /workspace/TRELLIS2/o-voxel /tmp/extensions/o-voxel && \
    pip install --no-cache-dir /tmp/extensions/o-voxel --no-build-isolation && \
    rm -rf /tmp/extensions/o-voxel && \
    rm -rf /tmp/extensions && \
    echo "✓ TRELLIS.2 dependencies installed"

# =============================================================================
# Install SHARP Dependencies
# =============================================================================
# SHARP works with Python 3.10 + NumPy 1.26.4 (tested compatible)
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing SHARP dependencies..." && \
    # SHARP's requirements (many already installed by Lyra: gsplat, timm, plyfile)
    pip install --no-cache-dir \
        pillow-heif \
        scipy \
        click \
        rich \
        matplotlib && \
    # Install SHARP itself (makes 'sharp' CLI available)
    pip install --no-cache-dir /workspace/ml-sharp && \
    echo "✓ SHARP installed"

# =============================================================================
# Install SuGaR Dependencies
# =============================================================================
# SuGaR requires pytorch3d, diff-gaussian-rasterization, simple-knn, open3d, pymcubes
# Note: CUDA compilation requires system compiler (same fix as gsplat)
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing SuGaR dependencies..." && \
    # Install pytorch3d (required for mesh operations)
    pip install --no-cache-dir "pytorch3d>=0.7.4" -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu121_pyt231/download.html || \
    pip install --no-cache-dir git+https://github.com/facebookresearch/pytorch3d.git && \
    # Install open3d for point cloud and mesh processing
    pip install --no-cache-dir open3d && \
    # Install pymcubes for marching cubes mesh extraction
    pip install --no-cache-dir PyMCubes && \
    echo "✓ SuGaR Python dependencies installed"

# Install SuGaR's Gaussian Splatting CUDA submodules
# Must use system compiler to avoid nvcc conflicts with conda compiler
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Installing SuGaR CUDA extensions..." && \
    export CC=/usr/bin/gcc && \
    export CXX=/usr/bin/g++ && \
    export CUDAHOSTCXX=/usr/bin/g++ && \
    export TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0" && \
    # Patch simple-knn for PyTorch 2.x compatibility (deprecated data<T>() -> data_ptr<T>())
    sed -i 's/\.data<float>()/\.data_ptr<float>()/g' /workspace/SuGaR/gaussian_splatting/submodules/simple-knn/spatial.cu && \
    sed -i 's/\.data<float>()/\.data_ptr<float>()/g' /workspace/SuGaR/gaussian_splatting/submodules/simple-knn/simple_knn.cu && \
    # Patch simple-knn to add missing FLT_MAX include and remove redundant __CUDACC__ define
    sed -i '1i #include <cfloat>' /workspace/SuGaR/gaussian_splatting/submodules/simple-knn/simple_knn.cu && \
    sed -i '/#define __CUDACC__/d' /workspace/SuGaR/gaussian_splatting/submodules/simple-knn/simple_knn.cu && \
    # Install diff-gaussian-rasterization
    cd /workspace/SuGaR/gaussian_splatting/submodules/diff-gaussian-rasterization && \
    pip install --no-cache-dir . && \
    # Install simple-knn
    cd /workspace/SuGaR/gaussian_splatting/submodules/simple-knn && \
    pip install --no-cache-dir . && \
    cd /workspace && \
    echo "✓ SuGaR CUDA extensions installed"

# =============================================================================
# Install API Server Dependencies
# =============================================================================
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    pip install --no-cache-dir \
        fastapi \
        uvicorn \
        python-multipart \
        runpod \
        boto3

# =============================================================================
# Fix utils3d Compatibility (MoGe requires utils3d.pt module)
# =============================================================================
# TRELLIS.2's utils3d version doesn't have the 'pt' submodule that MoGe needs.
# Reinstall MoGe to get the correct utils3d version for GEN3C depth estimation.
# Then restore GEN3C-critical packages that MoGe may have overwritten.
RUN source ~/miniforge3/bin/activate cosmos-predict1 && \
    echo "Fixing utils3d for MoGe compatibility..." && \
    # Install only utils3d from MoGe's requirements (not the full MoGe which overwrites too much)
    pip install --no-cache-dir git+https://github.com/EasternJournalist/utils3d.git@3fab839f0be9931dac7c8488eb0e1600c236e183 && \
    # Restore GEN3C-critical packages that may have been overwritten
    pip install --no-cache-dir "huggingface-hub>=0.26.0,<1.0" && \
    pip install --no-cache-dir transformer-engine[pytorch]==1.12.0 && \
    pip install --no-cache-dir numpy==1.26.4 && \
    echo "✓ utils3d fixed and GEN3C packages restored"

# =============================================================================
# Copy Server Scripts
# =============================================================================
COPY server_unified.py /workspace/server.py
COPY handler_unified.py /workspace/handler.py
COPY start_unified.sh /workspace/start.sh
COPY lyra_inference.py /workspace/lyra_inference.py
COPY sugar_inference.py /workspace/sugar_inference.py
RUN chmod +x /workspace/start.sh /workspace/lyra_inference.py /workspace/sugar_inference.py

# =============================================================================
# Environment Variables
# =============================================================================
ENV PYTHONPATH="/workspace/GEN3C:/workspace/lyra:/workspace/TRELLIS2:/workspace/ml-sharp/src:/workspace/SuGaR"
ENV GEN3C_CHECKPOINT_DIR="/workspace/checkpoints"
ENV LYRA_CHECKPOINT_DIR="/workspace/checkpoints/lyra"
ENV TRELLIS_CHECKPOINT_DIR="/workspace/checkpoints/trellis"
ENV SHARP_CHECKPOINT_DIR="/workspace/checkpoints/sharp"
ENV CONDA_DEFAULT_ENV="cosmos-predict1"
ENV TRANSFORMERS_CACHE="/workspace/checkpoints/huggingface"
ENV HF_HOME="/workspace/checkpoints/huggingface"

# =============================================================================
# Expose Ports
# =============================================================================
EXPOSE 8000

# =============================================================================
# Health Check
# =============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# =============================================================================
# Startup Command
# =============================================================================
CMD ["/workspace/start.sh"]
