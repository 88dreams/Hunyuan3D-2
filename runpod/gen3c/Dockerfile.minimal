# =============================================================================
# GEN3C Minimal Docker Image for RunPod
# =============================================================================
# Uses NVIDIA's official PyTorch image with everything pre-installed
# Only adds GEN3C code and our server scripts
# =============================================================================

# This image already has PyTorch, CUDA, cuDNN, etc.
FROM nvcr.io/nvidia/pytorch:24.01-py3

ENV DEBIAN_FRONTEND=noninteractive

# =============================================================================
# MINIMAL SYSTEM DEPENDENCIES
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs ffmpeg libgl1-mesa-glx libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && git lfs install

WORKDIR /workspace

# =============================================================================
# CLONE GEN3C
# =============================================================================
RUN git clone https://github.com/nv-tlabs/GEN3C.git /workspace/GEN3C

# =============================================================================
# PYTHON DEPENDENCIES (minimal - most are in base image)
# =============================================================================
RUN pip install --no-cache-dir \
    hydra-core==1.3.2 \
    omegaconf==2.3.0 \
    diffusers==0.32.2 \
    transformers==4.49.0 \
    huggingface_hub \
    safetensors \
    einops \
    decord \
    imageio[pyav,ffmpeg] \
    mediapy \
    loguru \
    warp-lang \
    fastapi \
    uvicorn \
    python-multipart \
    runpod

# Install MoGe
RUN pip install --no-cache-dir git+https://github.com/microsoft/MoGe.git

# =============================================================================
# COPY SERVER SCRIPTS
# =============================================================================
COPY server.py /workspace/server.py
COPY handler.py /workspace/handler.py
COPY start.sh /workspace/start.sh
RUN chmod +x /workspace/start.sh

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENV PYTHONPATH="/workspace/GEN3C"
ENV CUDA_HOME="/usr/local/cuda"
ENV GEN3C_CHECKPOINT_DIR="/workspace/checkpoints/Gen3C-Cosmos-7B"

EXPOSE 8000

CMD ["/workspace/start.sh"]

